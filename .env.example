# TimeTracker .env-Template (Referenz; der Installer schreibt dies mit
# zufälligem SECRET_KEY + DB-Passwort nach /opt/timetracker/.env).
# Erster Login (Benutzer "admin") wird automatisch Admin.

FLASK_APP=app
FLASK_ENV=production
APP_VERSION=v5.22.0
PORT=8080

# Pflicht: zufälliger Session-/CSRF-Schlüssel
#   openssl rand -hex 32
SECRET_KEY=bitte-aendern-mit-openssl-rand-hex-32

# PostgreSQL (nativ im CT, vom Installer angelegt)
DATABASE_URL=postgresql+psycopg2://timetracker:BITTE_AENDERN@localhost:5432/timetracker
POSTGRES_DB=timetracker
POSTGRES_USER=timetracker
POSTGRES_PASSWORD=BITTE_AENDERN

# Persistenz / Logs
LOG_FILE=/data/timetracker.log

# Region
TZ=Europe/Berlin
CURRENCY=EUR

# Login/Registrierung
ALLOW_SELF_REGISTER=true
ADMIN_USERNAMES=admin

# HTTP-Safe (LAN, kein TLS im CT)
WTF_CSRF_ENABLED=true
SESSION_COOKIE_SECURE=false
REMEMBER_COOKIE_SECURE=false
PREFERRED_URL_SCHEME=http

# Optionale Features (standardmäßig aus)
AI_ENABLED=false
ENABLE_TELEMETRY=false